# Copy to .env and fill in your Logz.io token for distributed tracing in the meeting.
# LOGZIO_TOKEN=your-token-here
LOGZIO_TYPE=backend-rebase
LOGZIO_SERVICE=Artur&Tom

# Load balancer listens here; blob nodes register against this address.
LB_PORT=8080
MASTER_NODE_ADDRESS=http://127.0.0.1:8080

# Each blob node needs a unique PORT and DATA_DIR when running multiple instances.
PORT=3001
NODE_ADVERTISE_HOST=127.0.0.1
NODE_NAME=node-1

# Cache proxy (optional front door in front of the load balancer).
TARGET_BLOB_SERVER=http://127.0.0.1:8080
CACHE_PROXY_PORT=9000
MAX_ITEMS_IN_CACHE=10
