# Copy to .env and adjust as needed.

# Where the users microservice listens.
USERS_HOST=0.0.0.0
USERS_PORT=8000

# Postgres connection (matches the docker command in the README/notes).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=usersdb
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: ship structured logs to Logz.io (same as the other services).
# LOGZIO_TOKEN=your-token-here
LOGZIO_TYPE=backend-rebase
LOGZIO_SERVICE=users-service
